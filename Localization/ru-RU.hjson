Mods: {
	AllStatsScaled: {
		Configs: {
			AllStatsScaledConfig: {
				DisplayName: Настройки
				ChangesApplyOnWorldLoad: All Stats Scaled Suvius': настройки изменены. Они вступят в силу при следующей загрузке мира.

				Headers: {
					EnemyStats:
						'''
						[c/FFD54F:В мультиплеере изменения вступают в силу при следующей загрузке мира.]
						[i:1274] Характеристики врагов
						'''
					HostileProjectiles: "[i:41] Вражеские снаряды"
					BossesAndRespawn: "[i:3319] Боссы и возрождение"
					Player: "[i:267] Игрок"
				}

				SimulatedPlayers: {
					Label: Симулированные игроки
					Tooltip: Сколько игроков игра считает онлайн при масштабировании врагов (1-255). Используется вместо реального числа игроков, пока включено «Включить симулированных игроков».
				}

				EnableSimulatedPlayers: {
					Label: Включить симулированных игроков
					Tooltip:
						'''
						Масштабирует врагов так, будто онлайн столько игроков, сколько указано в «Симулированные игроки».
						В мультиплеере заменяет реальное число игроков на сервере: при 4 игроках онлайн и значении 2 враги масштабируются как для 2.
						В основном влияет на боссов: ванильное масштабирование в мультиплеере повышает здоровье боссов (и часть их урона) за каждого дополнительного игрока.
						Враги Тыквенной и Морозной луны тоже масштабируются; обычные враги не меняются.
						Работает только в режимах эксперта и мастера или в режиме путешествия на сложности эксперта и выше.
						'''
				}

				HealthPercent: {
					Label: Здоровье врагов
					Tooltip: Здоровье врагов * ЗНАЧЕНИЕ%
				}

				EnemyImmunityPercent: {
					Label: Неуязвимость врагов (i-frames)
					Tooltip: Сколько враги остаются неуязвимыми после вашего удара * ЗНАЧЕНИЕ%. Меньше — ваше оружие бьёт чаще.
				}

				DamagePercent: {
					Label: Контактный урон врагов
					Tooltip: Урон, который враги наносят касанием * ЗНАЧЕНИЕ%
				}

				ProjectileDamagePercent: {
					Label: Урон вражеских снарядов
					Tooltip: Урон снарядов, выпущенных врагами и боссами * ЗНАЧЕНИЕ%
				}

				EnemySpeedPercent: {
					Label: Скорость передвижения врагов
					Tooltip: Как быстро двигаются враги * ЗНАЧЕНИЕ%. Также меняет высоту прыжка, скорость падения и то, как далеко их отбрасывает.
				}

				EnemyProjectileSpeedPercent: {
					Label: Скорость вражеских снарядов
					Tooltip: Как быстро летят снаряды врагов и боссов * ЗНАЧЕНИЕ%. Более быстрые снаряды летят и дальше.
				}

				DefensePercent: {
					Label: Защита врагов
					Tooltip: Защита врагов * ЗНАЧЕНИЕ%
				}

				BossHealthPercent: {
					Label: Здоровье боссов
					Tooltip: Здоровье боссов * ЗНАЧЕНИЕ%. Пожиратель миров и некоторые части и приспешники боссов, например руки Скелетрона и Ползуны, считаются обычными врагами.
				}

				BossDefensePercent: {
					Label: Защита боссов
					Tooltip: Защита боссов * ЗНАЧЕНИЕ%. Пожиратель миров и некоторые части и приспешники боссов, например руки Скелетрона и Ползуны, считаются обычными врагами.
				}

				BossDamagePercent: {
					Label: Контактный урон боссов
					Tooltip: Урон, который боссы наносят касанием * ЗНАЧЕНИЕ%. Пожиратель миров и некоторые части и приспешники боссов, например руки Скелетрона и Ползуны, считаются обычными врагами.
				}

				PlayerMaxHealthPercent: {
					Label: Макс. здоровье игрока
					Tooltip: Максимальное здоровье игрока * ЗНАЧЕНИЕ%. Не ниже 1.
				}

				PlayerDefensePercent: {
					Label: Защита игрока
					Tooltip: Защита игрока * ЗНАЧЕНИЕ%.
				}

				PlayerLifeRegenPercent: {
					Label: Регенерация здоровья игрока
					Tooltip: Как быстро вы восстанавливаете здоровье со временем * ЗНАЧЕНИЕ%. Урон от дебаффов не меняется.
				}

				PlayerImmunityPercent: {
					Label: Неуязвимость игрока (i-frames)
					Tooltip: Сколько вы остаётесь неуязвимым после удара * ЗНАЧЕНИЕ%.
				}

				PlayerKnockbackPercent: {
					Label: Отбрасывание игрока
					Tooltip: Как далеко вас отбрасывают удары * ЗНАЧЕНИЕ%.
				}

				PlayerRespawnPercent: {
					Label: Время возрождения
					Tooltip:
						'''
						Время до возрождения * ЗНАЧЕНИЕ%.
						В ванилле: 10 с, в режимах эксперта и мастера 15 с. Например, 200% в режиме эксперта = 30 с.
						В мультиплеере при смерти рядом с боссом вместо этого действует настройка боя с боссом. Максимум около 16 минут.
						'''
				}

				PlayerBossRespawnPercent: {
					Label: Время возрождения в бою с боссом
					Tooltip:
						'''
						Время до возрождения после смерти рядом с боссом (в пределах примерно 250 блоков) в мультиплеере * ЗНАЧЕНИЕ%.
						В ванилле: 20 с, в режимах эксперта и мастера 30 с, вдвое больше в мирах «for the worthy», если онлайн есть другой игрок. Например, 50% в режиме эксперта = 15 с.
						События не считаются, включая Марсианскую тарелку и Бога факелов. Максимум около 16 минут.
						'''
				}

				RespawnWhenBossFightEnds: {
					Label: Возрождение после боя с боссом
					Tooltip: В мультиплеере, если вы погибли в бою с боссом, вы возродитесь, как только не останется ни одного живого босса.
				}

				PlayerSpeedPercent: {
					Label: Скорость игрока
					Tooltip: Скорость игрока * ЗНАЧЕНИЕ%
				}
			}
		}
	}

	AllStatsScale.Configs.AllStatsScaledConfig.DisplayName: Настройки
}
